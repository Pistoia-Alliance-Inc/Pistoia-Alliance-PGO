  <rdf:Description rdf:nodeID="N299a908277a44aea8b4523f8e8c5c66b">
    <sh:pattern>[0-9]+</sh:pattern>
    <skos:scopeNote>General-purpose gene identifiers across organisms</skos:scopeNote>
    <void:uriSpace>https://www.ncbi.nlm.nih.gov/gene/</void:uriSpace>
    <dcterms:publisher>NCBI (US National Library of Medicine)</dcterms:publisher>
    <dcterms:title>NCBI Gene (EntrezGene)</dcterms:title>
    <skos:note>NCBI Gene — species-agnostic gene records; a primary bioinformatics gene resource</skos:note>
