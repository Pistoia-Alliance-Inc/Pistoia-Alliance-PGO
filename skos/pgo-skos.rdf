    <skos:definition xml:lang="en">A site is a spatial region bounded (in part or in whole) by material entities and may be occupied by material entities.</skos:definition>
    <rdfs:label xml:lang="en">site</rdfs:label>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:rights xml:lang="en">Semanticscience Integrated Ontology (SIO). Concept SIO_000019. http://semanticscience.org/resource/SIO_000019</dcterms:rights>
