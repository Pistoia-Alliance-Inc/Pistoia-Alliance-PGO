  <rdf:Description rdf:nodeID="N4710ca2ede434cfb9376174dc2109d33">
    <dcterms:type>registry</dcterms:type>
    <ns1:natureOfLicence>open — no conditions</ns1:natureOfLicence>
    <sh:pattern>[A-Z0-9]{10} (UNII — 10-character alphanumeric)</sh:pattern>
    <skos:note>FDA GSRS — Global Substance Registration System; UNII (Unique Ingredient Identifier) is the FDA standard for pharmaceutical substance identification; used in regulatory submissions, IDMP alignment, and drug product labelling. Covers all API modalities. CMC / Regulatory / Manufacturing</skos:note>
    <dcterms:license rdf:resource="https://www.usa.gov/government-works"/>
    <rdf:type rdf:resource="http://rdfs.org/ns/void#Dataset"/>
    <dcterms:rights>https://gsrs.ncats.nih.gov/</dcterms:rights>
    <ns1:identifierResolvability>yes</ns1:identifierResolvability>
    <skos:scopeNote>Primary regulatory-context source for API identification — small molecules, biologics, and ATMPs</skos:scopeNote>
    <dcterms:title>Global Substance Registration System (GSRS) — GINAS</dcterms:title>
    <dcat:endpointURL rdf:resource="https://gsrs.ncats.nih.gov/api/v1/"/>
    <void:uriSpace>https://gsrs.ncats.nih.gov/ginas/app/beta/</void:uriSpace>
