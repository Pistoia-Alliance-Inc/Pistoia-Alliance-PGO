  <rdf:Description rdf:about="https://spec.pistoiaalliance.org/PGO/ontology/PGO-00000033">
    <prov:generatedAtTime rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-24</prov:generatedAtTime>
    <rdfs:label xml:lang="en">clinical study subject</rdfs:label>
    <skos:altLabel xml:lang="en">Human research subject</skos:altLabel>
    <skos:altLabel xml:lang="en">Study participant</skos:altLabel>
    <skos:altLabel xml:lang="en">Trial subject</skos:altLabel>
    <skos:altLabel xml:lang="en">Clinical trial participant</skos:altLabel>
    <skos:broadMatch rdf:resource="https://bioschemas.org/BioChemEntity"/>
    <skos:broadMatch rdf:resource="http://hl7.org/fhir/ResearchSubject"/>
    <dcterms:source rdf:resource="https://evsexplore.semantics.cancer.gov/evsexplore/concept/ncit/C70668"/>
    <dcterms:identifier>PGO-00000033</dcterms:identifier>
    <ns1:preferredSource rdf:nodeID="Ndd49391a5d31480b9df4f361021e8215"/>
    <prov:used>2-PGO-templates/PGO-T-internal-record-template-v1.7.md</prov:used>
    <prov:used>2-PGO-templates/PGO-MD-output-template-v1.7.md</prov:used>
    <skos:example rdf:nodeID="N57c44954079144309d60ec6fedd1665a"/>
    <skos:editorialNote xml:lang="en">Clinical Study Subject: An individual who is the subject of a clinical study; specifically, a living individual whose physiological and behavioral characteristics and responses are the object of study in a research investigation. [NCIT C70668 (CDISC long form)]</skos:editorialNote>
    <skos:editorialNote xml:lang="en">Synonym 'Study participant': clinical context</skos:editorialNote>
    <dcterms:rights xml:lang="en">Licence of the definition source: Public domain / CC0 (NCIT). CDISC terminology: see https://www.cdisc.org/standards/terminology</dcterms:rights>
    <dcterms:rights xml:lang="en">CDISC. Clinical Study Subject definition. NCI Thesaurus C70668 (short formulation). https://evsexplore.semantics.cancer.gov/evsexplore/concept/ncit/C70668</dcterms:rights>
    <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q4204239"/>
    <skos:closeMatch rdf:resource="https://biolink.github.io/biolink-model/Human"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <prov:wasAttributedTo>pgo_r_to_public_md.v1.10.0.py</prov:wasAttributedTo>
    <skos:broader rdf:resource="https://spec.pistoiaalliance.org/PGO/ontology/PGO-00000000"/>
    <dcterms:description xml:lang="en">**Round 1** (2026-04-23) Clinical_Study_Subject builds on earlier alignment work on study subjects. An earlier proposal to adopt the NCIT definition of Study Subject (C41189) did not cover preclinical animal subjects well enough, so the clinical case is now a concept of its own. The session compared two definitions linked to NCIT C70668: the full NCIT definition and the shorter Clinical Data Interchange Standards Consortium (CDISC) definition, "a person who is enrolled in a clinical study or trial". Experts raised two problems with the longer text: it is more complex than needed, and its qualifier "living" fails for subjects who die during a study, whose samples and data may still be analyzed. The group also discussed alternative wordings and set them aside: "volunteer" would exclude children enrolled through proxy consent. The group converged on the shorter CDISC definition as the one with the fewest semantic problems. One expert recorded a minority view that "human being" (a biological notion) would be more precise than "person" (a legal notion), and accepted that PGO reuses the source definition without changing it. **Outcome:** Consensus reached on the CDISC short definition (via NCIT C70668). Label `Clinical_Study_Subject` confirmed. Minority view on "person" versus "human being" recorded.</dcterms:description>
    <skos:definition xml:lang="en">A person who is enrolled in a clinical study or trial.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C70668"/>
    <skos:prefLabel xml:lang="en">clinical study subject</skos:prefLabel>
    <skos:inScheme rdf:resource="https://spec.pistoiaalliance.org/PGO/ontology/PGOConceptScheme"/>
    <prov:endedAtTime rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-08</prov:endedAtTime>
  </rdf:Description>
