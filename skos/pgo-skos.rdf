    <skos:broader rdf:resource="https://spec.pistoiaalliance.org/PGO/ontology/PGO-00000000"/>
    <rdfs:label xml:lang="en">excipient</rdfs:label>
    <dcterms:rights xml:lang="en">ChEBI: Chemical Entities of Biological Interest, EMBL-EBI. CHEBI_75324. http://purl.obolibrary.org/obo/CHEBI_75324</dcterms:rights>
    <skos:definition xml:lang="en">A generally pharmacologically inactive substance that is formulated with the active ingredient of a medication.</skos:definition>
    <prov:generatedAtTime rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-24</prov:generatedAtTime>
    <ns1:preferredSource rdf:nodeID="N5f4d677806c947abbb868b2a95f3052c"/>
  </rdf:Description>
