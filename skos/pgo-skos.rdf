    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <skos:definition xml:lang="en">A functional unit of heredity which occupies a specific position on a particular chromosome and serves as the template for a product that contributes to a phenotype or a biological function.</skos:definition>
  </rdf:Description>
