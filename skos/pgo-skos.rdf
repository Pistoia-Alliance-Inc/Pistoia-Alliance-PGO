    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <skos:definition xml:lang="en">A sign, signal, circumstance, or symptom which serves to indicate or point out the cause, pathology, treatment, or issue of an attack of disease; the basis for initiation of a treatment for a disease or of a diagnostic test (causal, or symptomatic, or disease-specific indication).</skos:definition>
    <skos:altLabel xml:lang="en">therapeutic indication</skos:altLabel>
