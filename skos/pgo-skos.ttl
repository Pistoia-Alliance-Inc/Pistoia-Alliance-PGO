            dcterms:title "EDRN (Early Detection Research Network) Biomarker Database" ;
            dcterms:type "database" ;
            void:uriSpace "https://edrn.cancer.gov/data-and-resources/biomarkers/" ;
            skos:note "EDRN (NCI) — curated cancer early-detection biomarkers, one page per biomarker (HMDB description, aliases, organs, studies). Research & Early Development / Clinical" ;
            skos:scopeNote "Cancer biomarker instances (slug-based per-biomarker URLs)" ;
            dcat:endpointURL <https://edrn.cancer.gov/data-and-resources/biomarkers/> ;
            ns1:identifierResolvability "yes" ;
            ns1:natureOfLicence "open — no conditions" ] .

ns1:PGO-00000003 a skos:Concept ;
    rdfs:label "biospecimen"@en ;
    dcterms:description "**Round 1** (2025-05-08) The session focused on defining \"biospecimen\" in the context of pharmaceutical R&ED. Three definitions were considered. The expert group agreed on key scoping principles: The concept applies specifically to R&ED in pharma. It explicitly excludes purely physical-chemical specimens or samples not derived from biological entities, thereby providing necessary conceptual precision. The concept broadly aligns with \"sample\" but is more targeted and appropriate for biomedical research involving biological material. The NCIT_C70699 definition was the convergence candidate, recommended by three partner organizations and endorsed by (Peter McQuilton) and (Birgit Meldal). It was considered both comprehensive and appropriately scoped for PGO use. **Outcome:** Consensus reached on NCIT_C70699. Formal recommendation submitted to the Steering Group."@en ;
    dcterms:identifier "PGO-00000003" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "\"NCI THESAURUS™ is released under CC BY 4.0. Produced by the Enterprise Vocabulary Services group, National Cancer Institute, Maryland, USA.\""@en ;
    dcterms:source <https://evsexplore.semantics.cancer.gov/evsexplore/concept/ncit/C70699> ;
    skos:altLabel "biosample"@en,
        "specimen"@en ;
    skos:broadMatch <http://hl7.org/fhir/specimen>,
        <https://biolink.github.io/biolink-model/MaterialSample>,
        <https://bioschemas.org/Sample>,
        <https://www.wikidata.org/entity/Q2075980> ;
    skos:broader ns1:PGO-00000000 ;
    skos:definition "Any material sample taken from a biological entity for testing, diagnostic, propagation, treatment or research purposes, including a sample obtained from a living organism or taken from the biological object after halting of all its life functions. Biospecimen can contain one or more components including but not limited to cellular molecules, cells, tissues, organs, body fluids, embryos, and body excretory products."@en ;
    skos:editorialNote "Biospecimen: A material entity that derives from an anatomical part or substance arising from an organism, and bears the role that is gained during a biospecimen collection activity and that can be realized by using it in a study"@en,
        "Biospecimen: A material sample taken from a biological entity for testing, diagnostic, propagation, treatment or research purposes, including a sample obtained from a living organism or taken from the biological object after halting of all its life functions."@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/NCIT_C70699>,
        <https://www.wikidata.org/entity/Q485146> ;
    skos:example [ dcterms:description "EBI BioSamples example"@en ;
            dcterms:identifier <https://www.ebi.ac.uk/biosamples/samples/SAMEA1584504> ;
            rdf:value "SAMEA1584504" ;
            prov:wasDerivedFrom "EBI BioSamples" ] ;
    skos:inScheme ns1:PGOConceptScheme ;
    skos:prefLabel "biospecimen"@en ;
    prov:endedAtTime "2025-06-12"^^xsd:date ;
    prov:generatedAtTime "2026-11-24"^^xsd:date ;
    prov:used "2-PGO-templates/PGO-MD-output-template-v1.7.md",
        "2-PGO-templates/PGO-T-internal-record-template-v1.7.md" ;
    prov:wasAttributedTo "pgo_r_to_public_md.v1.10.0.py" ;
    ns1:preferredSource [ a void:Dataset ;
            dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
            dcterms:publisher "EMBL-EBI" ;
            dcterms:rights "https://www.ebi.ac.uk/biosamples/docs/references/api/search" ;
            dcterms:title "EBI BioSamples" ;
            dcterms:type "registry" ;
            void:uriSpace "https://www.ebi.ac.uk/biosamples" ;
            skos:note "EMBL-EBI BioSamples database. Research & Early Development. Covers only a subset of biospecimens; many biospecimens are physical lab materials with no public record, so public instance examples are limited" ;
            skos:scopeNote "Identifiers for biological samples from EBI BioSamples" ;
            dcat:endpointURL <https://www.ebi.ac.uk/biosamples/samples/> ;
            sh:pattern "SAMEA[0-9]+" ;
            ns1:identifierResolvability "yes" ;
            ns1:natureOfLicence "open — no conditions" ] .

ns1:PGO-00000004 a skos:Concept ;
    rdfs:label "cell"@en ;
    dcterms:description "**Round 1** (2024-11-21) The session focused on selecting the most appropriate definition for the core concept \"Cell\" in PGO, with particular attention to scoping relative to related concepts. Key discussion points: **Concept hierarchy**: \"Cell\" is the highest-level concept; \"cell type\" and \"cell line\" emerged as distinct concepts that should receive separate definitions in future PGO phases. **Multiple candidate definitions deemed acceptable**: All three candidates (NCIT_C12508, CL_0000000, EFO_0000324) were considered satisfactory for specific use cases. **Selection rationale**: NCIT_C12508 was preferred based on: (1) frequency of use in relevant biomedical applications; (2) its ability to anchor a generalisable, foundational biological concept; (3) ability to accommodate sub-concepts through PGO's planned LinkML framework. A mechanism for alternative definitions via LinkML was noted as a feature that would allow ontological flexibility and layered specificity. **Outcome:** Consensus reached on NCIT_C12508. Formal recommendation submitted to the Steering Group."@en ;
    dcterms:identifier "PGO-00000004" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "\"NCI THESAURUS™ is released under CC BY 4.0. Produced by the Enterprise Vocabulary Services group, National Cancer Institute, Maryland, USA.\""@en ;
    dcterms:source <https://evsexplore.semantics.cancer.gov/evsexplore/concept/ncit/C12508> ;
    skos:altLabel "cell"@en,
        "cell entity"@en ;
    skos:broader ns1:PGO-00000000 ;
    skos:closeMatch <http://hl7.org/fhir/BodyStructure>,
        schema:AnatomicalStructure ;
    skos:definition "The smallest units of living structure capable of independent existence, composed of a membrane-enclosed mass of protoplasm and containing a nucleus or nucleoid."@en ;
    skos:editorialNote "Cell Type: A cell type is a distinct morphological or functional form of cell. Examples are epithelial, glial etc. [http://www.ebi.ac.uk/efo/EFO_0000324]"@en,
        "Cell: A material entity of anatomical origin (part of or deriving from an organism) that has as its parts a maximally connected cell compartment surrounded by a plasma membrane. [http://purl.obolibrary.org/obo/CL_0000000]"@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/CL_0000000>,
        <http://purl.obolibrary.org/obo/GO_0005623>,
        <http://purl.obolibrary.org/obo/NCIT_C12508>,
        <https://biolink.github.io/biolink-model/Cell>,
        <https://www.wikidata.org/entity/Q7868> ;
    skos:example [ dcterms:description "The basic cellular unit of nervous tissue; consists of body, axon, and dendrites"@en ;
            dcterms:identifier <http://purl.obolibrary.org/obo/CL_0000540> ;
            rdf:value "neuron" ;
            prov:wasDerivedFrom "Cell Ontology" ],
        [ dcterms:description "Main structural component of the liver; specialised epithelial cells"@en ;
            dcterms:identifier <http://purl.obolibrary.org/obo/CL_0000182> ;
            rdf:value "hepatocyte" ;
            prov:wasDerivedFrom "Cell Ontology" ] ;
    skos:inScheme ns1:PGOConceptScheme ;
    skos:prefLabel "cell"@en ;
    prov:endedAtTime "2025-06-12"^^xsd:date ;
    prov:generatedAtTime "2026-11-24"^^xsd:date ;
    prov:used "2-PGO-templates/PGO-MD-output-template-v1.7.md",
        "2-PGO-templates/PGO-T-internal-record-template-v1.7.md" ;
    prov:wasAttributedTo "pgo_r_to_public_md.v1.10.0.py" ;
    ns1:preferredSource [ a void:Dataset ;
            dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
            dcterms:publisher "OBO Foundry / BRENDA (TU Braunschweig)" ;
            dcterms:rights "https://brenda-enzymes.org" ;
            dcterms:title "BRENDA Tissue Ontology (BTO)" ;
            dcterms:type "ontology" ;
            void:uriSpace "http://purl.obolibrary.org/obo/BTO_" ;
            skos:note "BRENDA Tissue Ontology (BTO). Research & Early Development" ;
            skos:scopeNote "Tissue and cell source ontology for enzyme and biomedical research" ;
            sh:pattern "BTO_[0-9]{7}" ;
            ns1:identifierResolvability "yes" ;
            ns1:natureOfLicence "open — attribution required" ],
        [ a void:Dataset ;
