            void:uriSpace "https://www.protocols.io/" ;
            skos:note "protocols.io — open-access repository of detailed scientific methods. Research & Early Development. REST API requires an API key (base endpoint: https://www.protocols.io/api/v4/)" ;
            skos:scopeNote "Enumerate specific protocol instances of assay methods; links to structured, citeable protocols" ;
            sh:pattern "doi:[0-9a-z/]+" ;
            ns1:identifierResolvability "yes" ;
            ns1:natureOfLicence "open — attribution required" ],
        [ a void:Dataset ;
            dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
