            dcterms:type "database" ;
            void:uriSpace "https://www.ncbi.nlm.nih.gov/taxonomy" ;
            skos:note "NCBI Taxonomy — global biological taxonomy authority. Research & Early Development / Clinical" ;
            skos:scopeNote "Species identifiers for all taxa including virus" ;
            dcat:endpointURL <https://api.ncbi.nlm.nih.gov/datasets/v2alpha/taxonomy/> ;
            sh:pattern "txid[0-9]+" ;
            ns1:identifierResolvability "yes" ;
