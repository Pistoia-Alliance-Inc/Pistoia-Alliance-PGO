            dcterms:type "ontology" ;
            void:uriSpace "http://semanticscience.org/resource/" ;
            skos:note "SIO as definition source; SIO_000019 is the anchor concept. Research & Early Development; Clinical Development. Available as OWL/RDF; no dedicated REST API; may be accessible via OLS4" ;
            skos:scopeNote "SIO provides a hierarchy of spatial and material entity concepts" ;
            sh:pattern "SIO_[0-9]{6}" ;
