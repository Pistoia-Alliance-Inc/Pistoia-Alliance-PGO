ns1:PGO-00000002 a skos:Concept ;
    rdfs:label "biomarker"@en ;
    dcterms:description "**Round 1** (2025-05-15) The session evaluated definitions for the concept \"biomarker\", despite its acknowledged complexity and multidimensionality. A key conceptual context was established early: in prior PGO discussions, \"biomarker\" had been identified as representing a **role** rather than a concrete material entity. This distinction was acknowledged as requiring additional care in implementation, potentially through LinkML modelling. Only two candidate definitions were formally evaluated: 1. **NCIT_C16342** (*\"A characteristic that can be objectively measured and serves as an indicator...\"*) — broadly defined, inclusive of diverse biomarker modalities (molecular, physiological, digital, behavioral). Received multiple endorsements. Considered sufficiently general to accommodate future extensions, though some suggested the wording could explicitly mention digital and imaging biomarkers as examples. 2. **CHEBI_59163** (*\"A substance used as an indicator of a biological state.\"*) — proposed by multiple partners but ultimately found too restrictive. ChEBI's substance-centric framework limits applicability to non-substance biomarkers (digital, behavioral indicators). The group noted the relatively low number of candidate definitions for a concept with recognized complexity, and flagged the need to source examples of public resources for biomarker instances. (Originally mis-referenced as GitHub issue #62, which in fact concerns Assay Method / another concept; the biomarker public-resource need is met by the MarkerDB, EDRN and BEST sources in §6.1/§6.2.) **Outcome:** Consensus reached on NCIT_C16342. Formal recommendation submitted to the Steering Group."@en ;
    dcterms:identifier "PGO-00000002" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "\"NCI THESAURUS™ is released under CC BY 4.0. Produced by the Enterprise Vocabulary Services group, National Cancer Institute, Maryland, USA.\""@en ;
    dcterms:source <https://evsexplore.semantics.cancer.gov/evsexplore/concept/ncit/C16342> ;
    skos:altLabel "biological marker"@en,
        "marker"@en ;
    skos:broadMatch <http://hl7.org/fhir/observation>,
        <http://purl.obolibrary.org/obo/OPMI_0000445>,
        <https://www.wikidata.org/entity/Q864574> ;
    skos:broader ns1:PGO-00000000 ;
    skos:definition "A characteristic that can be objectively measured and serves as an indicator for normal biologic processes, pathogenic processes, state of health or disease, the risk for disease development and/or prognosis, or responsiveness to a particular therapeutic intervention."@en ;
    skos:editorialNote "Biomarker: A substance used as an indicator of a biological state. [https://www.ebi.ac.uk/ols4/ontologies/chebi/classes/http%3A%2F%2Fpurl.obolibrary.org%2Fobo%2FCHEBI_59163]"@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/NCIT_C16342>,
        <https://www.wikidata.org/entity/Q864574> ;
    skos:example [ dcterms:description "Sequence-variant biomarker (MarkerDB MDB00595093): a SNP in the KCNH7 potassium-channel gene associated with cardiovascular disorders; illustrates the genetic/sequence-variant biomarker type"@en ;
            dcterms:identifier <https://markerdb.ca/sequence_variants/14032> ;
            rdf:value "rs602633 (KCNH7)" ;
            prov:wasDerivedFrom "MarkerDB" ],
        [ dcterms:description "Polyamine cancer early-detection biomarker; EDRN (NCI) biomarker record"@en ;
            dcterms:identifier <https://edrn.cancer.gov/data-and-resources/biomarkers/n1n8-acetylspermidine-acsperm/> ;
            rdf:value "(N1/N8)-acetylspermidine (AcSperm)" ;
            prov:wasDerivedFrom "EDRN" ],
        [ dcterms:description "Chemical biomarker (MarkerDB MDB00000006); illustrative example"@en ;
            dcterms:identifier <https://markerdb.ca/chemicals/7> ;
            rdf:value "Deoxyuridine" ;
            prov:wasDerivedFrom "MarkerDB" ] ;
    skos:inScheme ns1:PGOConceptScheme ;
    skos:prefLabel "biomarker"@en ;
    prov:endedAtTime "2025-06-12"^^xsd:date ;
    prov:generatedAtTime "2026-11-24"^^xsd:date ;
    prov:used "2-PGO-templates/PGO-MD-output-template-v1.7.md",
        "2-PGO-templates/PGO-T-internal-record-template-v1.7.md" ;
    prov:wasAttributedTo "pgo_r_to_public_md.v1.10.0.py" ;
    ns1:preferredSource [ a void:Dataset ;
            dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
            dcterms:publisher "Wishart Lab / University of Alberta" ;
            dcterms:rights "https://markerdb.ca" ;
            dcterms:title "MarkerDB" ;
            dcterms:type "database" ;
            void:uriSpace "https://markerdb.ca" ;
            skos:note "MarkerDB — curated biomarker database. Research & Early Development" ;
            skos:scopeNote "Chemical and protein biomarkers; requires investigation for use licensing" ;
            sh:pattern "MDB[0-9]+" ;
            ns1:identifierResolvability "yes" ;
            ns1:natureOfLicence "open — no conditions" ],
        [ a void:Dataset ;
            dcterms:license <https://www.ncbi.nlm.nih.gov/books/about/copyright/> ;
            dcterms:publisher "FDA-NIH Biomarker Working Group" ;
            dcterms:rights "https://www.ncbi.nlm.nih.gov/books/NBK326791/" ;
            dcterms:title "BEST (Biomarkers, EndpointS, and other Tools)" ;
            dcterms:type "controlled vocabulary" ;
            void:uriSpace "https://www.ncbi.nlm.nih.gov/books/NBK326791/" ;
            skos:note "BEST (FDA/NIH). Delivered as an NIH Bookshelf resource; defines biomarker categories (molecular, histologic, radiographic, physiologic) but has no individual resolvable per-term URIs, so it is a reference source only, not an instance-URL source. Retained in PGO V2.0 as a documented stub: potentially a high-value instance-URL source for biomarkers if a machine-readable (RDF/database) version is or becomes available. Asiyah Yu Lin to follow up with FDA/NIH on whether BEST could be offered as a database/RDF (no response yet as of 2026-10-19)" ;
            skos:scopeNote "Biomarker category definitions (source-only stub; no instance URLs yet; watch for a machine-readable release)" ;
            ns1:identifierResolvability "no" ;
            ns1:natureOfLicence "open — no conditions" ],
