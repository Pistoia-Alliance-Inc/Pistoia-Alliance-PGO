            skos:scopeNote "Enumerate clinical study subject instances linked to cancer studies" ;
            dcat:endpointURL <https://www.cbioportal.org/api/> ;
            sh:pattern "Study-specific compound IDs" ;
            ns1:identifierResolvability "partial" ;
            ns1:natureOfLicence "open — attribution required" ],
        [ a void:Dataset ;
