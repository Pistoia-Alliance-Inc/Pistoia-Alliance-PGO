ns1:PGO-00000017 a skos:Concept ;
    rdfs:label "unit"@en ;
    dcterms:description "**Round 1** (2024-10-24) The definitions were considered quite similar across candidates. A preference was stated for the QUDT unit definition for accuracy and precision. The QUDT definition is also used in the CMC Process Ontology (Pistoia), which imports QUDT for quantities and units. The proposal: adopt the QUDT_unit definition as the PGO \"unit\" definition, unless there is conflicting input from the CMC Process Ontology (there was none). **Outcome:** Preliminary consensus on QUDT. Additional expert input requested from IDMP-O team."@en ;
    dcterms:identifier "PGO-00000017" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "\"QUDT is published under the Creative Commons Attribution 4.0 International License. © QUDT.org Contributors.\""@en ;
    dcterms:source <http://qudt.org/schema/qudt/Unit> ;
    skos:broader ns1:PGO-00000000 ;
    skos:definition "A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension). For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures). Any measurement of the length can be expressed as a number multiplied by the unit meter. More formally, the value of a physical quantity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as Q=nU."@en ;
    skos:editorialNote "Unit of Measure: A named quantity in terms of which other quantities are measured or specified, used as a standard measurement of like kinds. [https://evsexplore.semantics.cancer.gov/evsexplore/concept/ncit/C25709]"@en,
        "measurement unit: Real scalar quantity, defined and adopted by convention, with which any other quantity of the same kind can be compared to express the ratio of the second quantity to the first one as a number. [https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit]"@en,
        "unit of measurement: A unit of measurement is a definite magnitude of a physical quantity, defined and adopted by convention and/or by law, that is used as a standard for measurement of the same physical quantity. [https://www.ebi.ac.uk/ols4/ontologies/sio/classes/http%253A%252F%252Fsemanticscience.org%252Fresource%252FSIO_000074]"@en,
        "unit of measurement: The definite magnitude of a physical quantity or of time. It has a quantity and a unit associated with it. [https://www.ebi.ac.uk/ols4/ontologies/bao/classes/http%253A%252F%252Fwww.bioassayontology.org%252Fbao%2523BAO_0000077]"@en ;
    skos:exactMatch <http://qudt.org/schema/qudt/Unit> ;
    skos:example [ dcterms:description "SI-derived unit of mass (10⁻³ grams) — QUDT"@en ;
            dcterms:identifier <https://qudt.org/vocab/unit/MilliGM> ;
            rdf:value "milligram" ;
            prov:wasDerivedFrom "QUDT" ],
        [ dcterms:description "SI-derived unit of mass (10⁻³ grams) — UO"@en ;
            dcterms:identifier <http://purl.obolibrary.org/obo/UO_0000022> ;
            rdf:value "milligram" ;
            prov:wasDerivedFrom "UO" ],
        [ dcterms:description "SI unit of electric current"@en ;
            dcterms:identifier <https://qudt.org/vocab/unit/A.html> ;
            rdf:value "Ampere" ;
            prov:wasDerivedFrom "QUDT" ] ;
    skos:inScheme ns1:PGOConceptScheme ;
    skos:prefLabel "unit"@en ;
    prov:endedAtTime "2025-03-12"^^xsd:date ;
    prov:generatedAtTime "2026-11-24"^^xsd:date ;
    prov:used "2-PGO-templates/PGO-MD-output-template-v1.7.md",
        "2-PGO-templates/PGO-T-internal-record-template-v1.7.md" ;
    prov:wasAttributedTo "pgo_r_to_public_md.v1.10.0.py" ;
    ns1:preferredSource [ a void:Dataset ;
            dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
            dcterms:publisher "QUDT.org" ;
            dcterms:rights "https://qudt.org/" ;
            dcterms:title "QUDT — Units Vocabulary" ;
