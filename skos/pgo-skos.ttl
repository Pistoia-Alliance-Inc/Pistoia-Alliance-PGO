            rdf:value "sodium chloride" ;
            prov:wasDerivedFrom "ChEBI" ],
        [ dcterms:description "Simple organic compound (carboxylic acid); ChemSpider ID 1005"@en ;
            dcterms:identifier <https://www.chemspider.com/Chemical-Structure.1005.html> ;
            rdf:value "propionic acid" ;
            prov:wasDerivedFrom "ChemSpider" ],
        [ dcterms:description "Inorganic compound example; ChemSpider ID 937"@en ;
            dcterms:identifier <http://www.chemspider.com/Chemical-Structure.937.html> ;
            rdf:value "water" ;
            prov:wasDerivedFrom "ChemSpider" ],
        [ dcterms:description "Simple organic compound example"@en ;
            dcterms:identifier <https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16236> ;
            rdf:value "ethanol" ;
            prov:wasDerivedFrom "ChEBI" ],
        [ dcterms:description "Stable-isotope-labeled (13C/2H) L-alanine; CAS RN 160033-81-8 (plain L-alanine 56-41-1 is not in the free subset)"@en ;
            dcterms:identifier <https://commonchemistry.cas.org/detail?cas_rn=160033-81-8&search=O%3DC(O)C(N)C> ;
            rdf:value "L-Alanine-3-13C-2-d" ;
            prov:wasDerivedFrom "CAS Common Chemistry" ],
        [ dcterms:description "Acetylsalicylic acid — CID 2244; illustrates PubChem as compound source"@en ;
            dcterms:identifier <https://pubchem.ncbi.nlm.nih.gov/compound/2244> ;
            rdf:value "aspirin" ;
            prov:wasDerivedFrom "PubChem" ],
        [ dcterms:description "Compound (as opposed to \"aspirin\", which is a product)"@en ;
            dcterms:identifier <https://www.ebi.ac.uk/chembl/explore/compound/CHEMBL25> ;
            rdf:value "acetylsalicylic acid" ;
            prov:wasDerivedFrom "ChEMBL" ] ;
    skos:inScheme ns1:PGOConceptScheme ;
    skos:prefLabel "compound"@en ;
