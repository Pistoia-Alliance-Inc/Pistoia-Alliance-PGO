            dcterms:title "FDA Drugs@FDA" ;
            dcterms:type "registry" ;
            void:uriSpace "https://www.accessdata.fda.gov/scripts/cder/daf/" ;
            skos:note "FDA Drugs@FDA. Clinical / Regulatory" ;
            skos:scopeNote "FDA-approved pharmaceutical product identifiers" ;
            dcat:endpointURL <https://api.fda.gov/drug/drugsfda.json> ;
            ns1:identifierResolvability "yes" ;
            ns1:natureOfLicence "open — no conditions" ],
