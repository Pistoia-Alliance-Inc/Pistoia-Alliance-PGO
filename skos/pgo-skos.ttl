            skos:note "QUDT unit vocabulary — comprehensive library of units. Research & Early Development / Clinical. No conventional REST API; machine-readable data via SPARQL endpoint (https://www.qudt.org/sparql; see void:sparqlEndpoint) and RDF/Turtle downloads" ;
            skos:scopeNote "Unit identifiers for all quantitative data in pharma R&ED" ;
            sh:pattern "qudt:unit/[A-Z_a-z-]+" ;
            ns1:identifierResolvability "yes" ;
            ns1:natureOfLicence "open — attribution required" ],
        [ a void:Dataset ;
