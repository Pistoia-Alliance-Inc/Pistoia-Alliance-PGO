            dcterms:type "ontology" ;
            void:uriSpace "http://purl.obolibrary.org/obo/OBI_" ;
            skos:note "OBI — Ontology for Biomedical Investigations; hierarchical classification of assay and method types. Research & Early Development" ;
            skos:scopeNote "Enumerate assay method types used in biomedical research; stable OBO Foundry IRIs" ;
            dcat:endpointURL <https://www.ebi.ac.uk/ols4/api/ontologies/obi> ;
            sh:pattern "OBI_[0-9]+" ;
