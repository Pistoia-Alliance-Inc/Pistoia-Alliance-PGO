ns1:PGO-00000016 a skos:Concept ;
    rdfs:label "substance"@en ;
    dcterms:description "**Round 1** (2025-03-06) The session jointly evaluated \"Substance\" and \"Compound\". Key findings: **IDMP-O Substance**: The definition appears to be an \"information or specification entity\" rather than a material entity — a concern flagged for potential IDMP-O engagement (question: what is the rationale for choosing a specification entity over a material entity?). \"Substance\" has a customary meaning as a functional, contextual term for relatively homogeneous materials (e.g., plastic, wood, tea). **NCIT_C45306** emerged as the consensus candidate: three partners indicated use; endorsed by CS, BM, PMQ. Cross-concept evaluation: \"Compound\" has more precise chemical composition than \"Substance\"; \"Chemical compound\" may be a more accurate label for compound. Some \"substances\" may also be \"compounds\" or \"drugs\" — semantic overlap due to usage. Not all \"substances\" are \"compounds\" or \"drugs\" — there is merit in retaining \"substance\" as a distinct core concept. Expert group tasked with providing examples of substances that are not compounds or drugs. **Outcome:** Consensus on NCIT_C45306. The group agreed to: (1) evaluate \"substance\" in conjunction with \"compound\" — done on 2025-03-06; (2) evaluate in conjunction with \"product\" — done on 2025-05-23."@en ;
    dcterms:identifier "PGO-00000016" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "\"NCI THESAURUS™ is released under CC BY 4.0. Produced by the Enterprise Vocabulary Services group, National Cancer Institute, Maryland, USA.\""@en ;
    dcterms:source <https://evsexplore.semantics.cancer.gov/evsexplore/concept/ncit/C45306> ;
    skos:altLabel "material"@en,
        "pharmaceutical substance"@en ;
    skos:broader ns1:PGO-00000000 ;
    skos:closeMatch schema:Substance,
        <https://spec.pistoiaalliance.org/idmp/ontology/ISO11238-Substances/Substance> ;
    skos:definition "Any matter of defined composition that has discrete existence, whose origin may be biological, mineral or chemical."@en ;
    skos:editorialNote "Chemical Entity: A chemical entity is a physical entity of interest in chemistry including molecular entities, parts thereof, and chemical substances. [http://purl.obolibrary.org/obo/CHEBI_24431]"@en,
        "Drug or Chemical by Structure: Substances that are grouped or classified by chemical composition. [https://evsexplore.semantics.cancer.gov/evsexplore/concept/ncit/C1913]"@en,
        "Substance: A homogeneous material with a definite composition. [http://hl7.org/fhir/substance.html]"@en,
        "Substance: Any matter of defined composition that has discrete existence, whose origin may be biological, mineral or chemical. [https://schema.org/Substance]"@en,
        "Substance: Specification for matter of defined composition that has discrete existence, whose origin may be biological, mineral or chemical. [https://spec.edmcouncil.org/idmp/ontology/ISO/ISO11238-Substances/Substance]"@en ;
    skos:exactMatch <http://hl7.org/fhir/Substance>,
        <http://purl.obolibrary.org/obo/CHEBI_59999>,
        <http://purl.obolibrary.org/obo/NCIT_C45306>,
        <https://www.wikidata.org/entity/Q214609> ;
    skos:example [ dcterms:description "Biopolymer substance example (collagen-derived); ChEBI:5291"@en ;
            dcterms:identifier <https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5291> ;
            rdf:value "gelatin" ;
            prov:wasDerivedFrom "ChEBI" ],
        [ dcterms:description "Substance (also a compound) — illustrates overlap"@en ;
            dcterms:identifier <https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:15377> ;
            rdf:value "water" ;
            prov:wasDerivedFrom "ChEBI" ],
        [ dcterms:description "Substance that is not a drug or compound"@en ;
            dcterms:identifier <https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50825> ;
            rdf:value "gold nanoparticle" ;
            prov:wasDerivedFrom "ChEBI" ],
        [ dcterms:description "GSRS entry for caffeine (UNII 3G6A5W338E); demonstrates GSRS substance registration"@en ;
            dcterms:identifier <https://gsrs.ncats.nih.gov/ginas/app/ui/substances/3G6A5W338E> ;
            rdf:value "caffeine" ;
            prov:wasDerivedFrom "GSRS" ],
        [ dcterms:description "Mineral substance — not a compound or drug"@en ;
            dcterms:identifier <https://pubchem.ncbi.nlm.nih.gov/compound/Graphite> ;
            rdf:value "graphite" ;
            prov:wasDerivedFrom "PubChem" ] ;
    skos:inScheme ns1:PGOConceptScheme ;
    skos:prefLabel "substance"@en ;
    prov:endedAtTime "2025-06-12"^^xsd:date ;
    prov:generatedAtTime "2026-11-24"^^xsd:date ;
    prov:used "2-PGO-templates/PGO-MD-output-template-v1.7.md",
        "2-PGO-templates/PGO-T-internal-record-template-v1.7.md" ;
    prov:wasAttributedTo "pgo_r_to_public_md.v1.10.0.py" ;
