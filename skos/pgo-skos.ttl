ns1:PGO-00000012 a skos:Concept ;
    rdfs:label "indication"@en ;
    dcterms:description "**Round 1** (2024-09-11) The session reviewed six candidate definitions for \"indication\". Several definitions were immediately excluded due to the absence of a resolvable URI. Two candidates remained viable: 1. **NCIT_C41184** — provides a resolvable IRI with CC BY 4.0 license. 2. **CDISC Glossary** — the CDISC definition is preferred by some experts for its clarity (\"A health problem or disease that is identified as likely to be benefited by a therapy...\"), but CDISC reuses the NCIT code C41184 with its own wording, and no separate URI exists for the CDISC-specific definition. Discussion notes: \"Abnormal\" or \"pathological\" are unnecessarily restrictive when defining indication. The distinction between sign and symptom in the NCIT definition was noted. NCIT code C41184 may be acceptable, with all alternate definitions treated as equally valid. The group reached consensus: adopt NCIT_C41184 as the primary definition, with all listed alternate definitions acknowledged as equally valid. **Outcome:** Consensus on NCIT_C41184 as primary definition, CDISC definition as alternative label. Submitted to Steering Group."@en ;
    dcterms:identifier "PGO-00000012" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "\"NCI THESAURUS™ is released under CC BY 4.0. Produced by the Enterprise Vocabulary Services group, National Cancer Institute, Maryland, USA.\""@en ;
    dcterms:source <https://evsexplore.semantics.cancer.gov/evsexplore/concept/ncit/C41184> ;
    skos:altLabel "therapeutic indication"@en ;
    skos:broadMatch <http://hl7.org/fhir/Condition>,
        <https://biolink.github.io/biolink-model/Disease>,
        schema:MedicalCondition ;
    skos:broader ns1:PGO-00000000 ;
    skos:definition "A sign, signal, circumstance, or symptom which serves to indicate or point out the cause, pathology, treatment, or issue of an attack of disease; the basis for initiation of a treatment for a disease or of a diagnostic test (causal, or symptomatic, or disease-specific indication)."@en ;
    skos:editorialNote "Indication: Any abnormal condition of the body ... Includes diseases, injuries, disabilities, disorders, syndromes."@en,
        "Indication: Intended use of the Medicinal Product as authorized by the Medicines Regulatory Agency in a jurisdiction"@en,
        "Indication: The disease or condition the intervention will diagnose, treat, prevent, cure, or mitigate. [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]"@en,
        "indication: Classifier for diseases, symptoms or procedures from medical terminology that is used for, but not limited to, the registration, documentation and safety monitoring of medicinal products. [https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/IndicationAsDiseaseSymptomProcedure]"@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/NCIT_C41184>,
        <https://www.wikidata.org/entity/Q496997> ;
    skos:example [ dcterms:description "Example indication: glycaemic abnormality"@en ;
            dcterms:identifier <https://hpo.jax.org/browse/term/HP:0011015> ;
            rdf:value "Abnormal blood glucose concentration" ;
            prov:wasDerivedFrom "HPO" ],
        [ dcterms:description "Neurodegenerative disorder used as an indication for neuroprotective/dopaminergic treatments"@en ;
            dcterms:identifier <https://monarchinitiative.org/MONDO:0005180> ;
            rdf:value "Parkinson's disease" ;
            prov:wasDerivedFrom "MONDO" ],
        [ dcterms:description "Example indication: low blood pressure"@en ;
            dcterms:identifier <https://hpo.jax.org/browse/term/HP:0002615> ;
            rdf:value "Hypotension" ;
            prov:wasDerivedFrom "HPO" ],
        [ dcterms:description "EFO entry for T2DM — used in GWAS/experimental annotation"@en ;
            dcterms:identifier <https://www.ebi.ac.uk/efo/EFO_0001360> ;
            rdf:value "type 2 diabetes mellitus" ;
            prov:wasDerivedFrom "EFO" ],
        [ dcterms:description "Metabolic disease indication — Disease Ontology"@en ;
            dcterms:identifier <https://disease-ontology.org/?id=DOID:9352> ;
            rdf:value "type 2 diabetes mellitus" ;
            prov:wasDerivedFrom "Disease Ontology" ] ;
    skos:inScheme ns1:PGOConceptScheme ;
    skos:prefLabel "indication"@en ;
    prov:endedAtTime "2025-06-12"^^xsd:date ;
    prov:generatedAtTime "2026-11-24"^^xsd:date ;
